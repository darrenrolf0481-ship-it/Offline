{
  "description": "Example MCP server configurations for different clients",
  "configurations": {
    "claude_desktop": {
      "description": "Configuration for Claude Desktop",
      "config_file_location": {
        "macos": "~/Library/Application Support/Claude/claude_desktop_config.json",
        "windows": "%APPDATA%\\Claude\\claude_desktop_config.json"
      },
      "single_server_example": {
        "mcpServers": {
          "gcloud-tools": {
            "command": "node",
            "args": ["/absolute/path/to/mcp-vibe-coding-tools/dist/gcloud-server.js"]
          }
        }
      },
      "all_servers_example": {
        "mcpServers": {
          "vibe-coding-tools": {
            "command": "node",
            "args": ["/absolute/path/to/mcp-vibe-coding-tools/dist/mcp-vibe-coding-tools.js"],
            "env": {
              "WORKSPACE_PATH": "/path/to/your/workspace"
            }
          },
          "gitops-tools": {
            "command": "node",
            "args": ["/absolute/path/to/mcp-vibe-coding-tools/dist/gitops-server.js"],
            "env": {
              "GITHUB_API_KEY": "your-github-token",
              "GITLAB_API_KEY": "your-gitlab-token"
            }
          },
          "gcloud-tools": {
            "command": "node",
            "args": ["/absolute/path/to/mcp-vibe-coding-tools/dist/gcloud-server.js"]
          }
        }
      },
      "with_service_account": {
        "mcpServers": {
          "gcloud-tools": {
            "command": "node",
            "args": ["/absolute/path/to/mcp-vibe-coding-tools/dist/gcloud-server.js"],
            "env": {
              "GOOGLE_APPLICATION_CREDENTIALS": "/path/to/service-account-key.json",
              "CLOUDSDK_CORE_PROJECT": "my-project-id",
              "CLOUDSDK_COMPUTE_REGION": "us-central1",
              "CLOUDSDK_COMPUTE_ZONE": "us-central1-a"
            }
          }
        }
      }
    },
